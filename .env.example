# URL do backend — server-side only (não precisa de NEXT_PUBLIC_)
# Usado pelo proxy Next.js em app/api/v1/[...path]/route.ts
BACKEND_URL=https://seu-backend.onrender.com

# URL do frontend (usado pelo backend para gerar links de email)
APP_URL=https://seu-frontend.vercel.app

# Desenvolvimento local (.env.local)
# BACKEND_URL=http://localhost:8080
